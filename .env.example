# =============================================================================
# DIGITAL PRODUCT RENTAL MONITORING SYSTEM — ENVIRONMENT CONFIGURATION
# =============================================================================

# Application
APP_NAME="Digital Product Rental Monitoring System"
APP_ENV=development
DEBUG=true
API_V1_STR=/api/v1
BUSINESS_TIMEZONE=Asia/Jakarta
DEFAULT_CURRENCY=IDR

# Security & Auth
SECRET_KEY=change-this-to-a-cryptographically-secure-random-secret-key-min-32-chars
# Development-only key; generate a unique key for production with:
# python -c "import base64,secrets; print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
CREDENTIALS_ENCRYPTION_KEY=MDAwMDAwMDAwMDAwMDAwMDAwMDAwMDAwMDAwMDAwMDA=
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
INITIAL_OWNER_EMAIL=owner@example.com
INITIAL_OWNER_PASSWORD=ChangeMe123!
CORS_ORIGINS=["http://localhost:5173","http://localhost:5174","http://127.0.0.1:5173","http://127.0.0.1:5174"]

# Public DNS name for Caddy HTTPS in production; use localhost for local Docker testing.
DOMAIN=localhost
CADDYFILE_PATH=./infra/Caddyfile
# Keep public defaults for standalone deployments; CloudPanel deployments should bind to loopback.
CADDY_HTTP_BIND=0.0.0.0:80
CADDY_HTTPS_BIND=0.0.0.0:443

# PostgreSQL Database (Single Source of Truth)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=rental_admin
POSTGRES_PASSWORD=rental_secret_password
POSTGRES_DB=rental_monitoring
DATABASE_URL=postgresql+psycopg://rental_admin:rental_secret_password@localhost:5432/rental_monitoring

# Redis (Celery Broker & Result Backend)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# Telegram Bot (aiogram 3.x)
TELEGRAM_BOT_TOKEN=0000000000:AAExampleBotTokenReplaceBeforeRunningBot
TELEGRAM_ADMIN_USER_IDS=[123456789]
# Optional numeric chat ID (usually negative) or @channelusername; add the bot as an admin.
TELEGRAM_FEEDBACK_CHANNEL_ID=
TELEGRAM_LINK_TOKEN_EXPIRE_MINUTES=30

# Notification & Reminder Defaults
DEFAULT_REMINDER_SEND_HOUR_WIB=9
DEFAULT_REMINDER_SEND_MINUTE_WIB=0
DEFAULT_OFFER_EXPIRE_HOURS=72

# Vue 3 + Vite frontend is served by Nginx behind Caddy.
